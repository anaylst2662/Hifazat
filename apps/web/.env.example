# Settings for the web app. For your own computer: copy to ".env.local" (ignored by Git).
# On Vercel: add the same names under Project → Settings → Environment Variables.
#
# ONLY these public values belong here. They are designed to be visible in the
# browser; the database security rules (Row Level Security) protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: set to "false" to hide the yellow "Test version" banner (only at launch).
# NEXT_PUBLIC_SHOW_PREVIEW_BANNER=true

# NEVER put these here or in Vercel:
#   - the Supabase service_role / secret key
#   - the Anthropic (Claude) API key  -> goes in Supabase Edge Function secrets
#   - the database password
