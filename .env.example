# Copy this file to ".env" and fill in real values. ".env" is ignored by Git.
# NEVER put real values in this example file.

# Public values (safe to be inside the app; protected by Row Level Security):
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# SECRET values below live ONLY in the Supabase dashboard (Edge Function secrets),
# never in the app and never in Git. Listed here only as a reminder:
# ANTHROPIC_API_KEY  -> set with: supabase secrets set ANTHROPIC_API_KEY=...
# SUPABASE_SERVICE_ROLE_KEY -> never leaves the Supabase dashboard
